# RAWONE Cards — copy to /opt/cards/.env on the VPS (chmod 600). Never commit real values.
# Generate secrets with:  openssl rand -base64 48

# ---------- App ----------
NODE_ENV=production
BASE_URL=https://card.rawone.co.in     # card links, QR codes and NFC URLs are built from this
TZ_OFFSET_MIN=330                           # IST, used for "per day" stats
IMAGE=ghcr.io/umangrrathi-ui/rawone-cards:latest
CARDS_HOST=card.rawone.co.in           # Traefik routes this hostname to the app
WEB_NETWORK=root_default                    # docker network Traefik is attached to

# ---------- Auth ----------
SESSION_SECRET=                             # 32+ random chars; rotating it logs everyone out
DATA_KEY=                                   # 32+ random chars; encrypts 2FA secrets. Do NOT rotate without re-enrolling staff 2FA
ADMIN_EMAILS=                               # comma separated; these accounts become admin after email verify

# ---------- Database (MySQL in docker-compose) ----------
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# DATABASE_URL is built by docker-compose from MYSQL_PASSWORD
DB_POOL=8

# ---------- Redis ----------
REDIS_PASSWORD=
# REDIS_URL is built by docker-compose from REDIS_PASSWORD

# ---------- Email (Resend) ----------
RESEND_API_KEY=
MAIL_FROM="RAWONE Cards <no-reply@rawone.co.in>"

# ---------- Bot check (Cloudflare Turnstile) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---------- Photos (Cloudflare R2). Empty = stored on the VPS disk in MEDIA_DIR ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rawone-cards-media
MEDIA_DIR=/app/data/media

# ---------- Backups (scripts/backup.sh) — a separate R2 bucket + key with write-only access ----------
BACKUP_PASSPHRASE=                          # encrypts dumps; keep a copy in your password manager or backups are useless
BACKUP_BUCKET=rawone-cards-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
