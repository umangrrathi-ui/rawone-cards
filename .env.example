# ---------- App ----------
NODE_ENV=production
BASE_URL=https://cards.example.com        # card links, QR codes and NFC URLs are built from this
TZ_OFFSET_MIN=330                          # IST

# ---------- Auth ----------
ADMIN_PASSWORD=change-me-12+chars
SESSION_SECRET=generate-with-openssl-rand  # 32+ random chars; rotating it logs everyone out

# ---------- Database (Hostinger MySQL) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uXXXXXXXXX_cards
DB_USER=uXXXXXXXXX_cards
DB_PASSWORD=change-me
# or one line: DATABASE_URL=mysql://USER:PASS@localhost:3306/DBNAME

# ---------- Local testing only ----------
# STORE=file                               # JSON file in ./data instead of MySQL. Never on production.
